APP_NAME="CSMF-MRS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://csmf-mrs:8003

# The Nuxt web app (src/web). Used for CORS and Sanctum's stateful session.
FRONTEND_URL=http://csmf-mrs:8030
CORS_ALLOWED_ORIGINS=http://csmf-mrs:8030
SANCTUM_STATEFUL_DOMAINS=csmf-mrs:8030

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Same server as PRJ-itsms: XAMPP's database server on port 3306.
# Use the "mysql" driver (not "mariadb") so UUID columns are CHAR(36).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_csmf_mrs_prj
DB_USERNAME=root
DB_PASSWORD=

# Cookies are shared between csmf-mrs:8030 (web) and csmf-mrs:8003 (API).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=csmf-mrs
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# No outbound mail in v1 (out of scope); messages are written to the log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@csmf-mrs.local"
MAIL_FROM_NAME="${APP_NAME}"
